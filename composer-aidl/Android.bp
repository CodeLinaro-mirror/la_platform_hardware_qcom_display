soong_config_module_type_import {
  from: "hardware/qcom/display/Android.bp",
  module_types: [
      "display_config_idl_cc_defaults",
      "composer_lib_defaults",
  ],
}

soong_config_module_type {
  name: "vendor_composer_lib_defaults",
  module_type: "cc_defaults",
  config_namespace: "qti",
  variables: [
      "vndk",
  ],
  properties: [
      "shared_libs",
      "vintf_fragments",
      "cflags",
  ],
}

soong_config_string_variable {
     name: "vndk",
     values: ["version_1","version_2"],
}

vendor_composer_lib_defaults {
  name: "vendor_shared_composer_vndk_lib",
  soong_config_variables: {
    vndk: {
       version_1: {
          shared_libs: [
                "vendor.qti.hardware.display.composer3-V1-ndk",
          ],
       },
       version_2: {
          shared_libs: [
                "vendor.qti.hardware.display.composer3-V2-ndk",
          ],
       },
    }
  },
}


composer_lib_defaults {
  name: "shared_composer_vndk_lib",
  soong_config_variables: {
    vndk: {
       version_2: {
          shared_libs: [
                "android.hardware.graphics.composer3-V2-ndk",
          ],
       },

       version_3: {
          cflags: [
              "-DENABLE_COMPOSER3_V3=1",
          ],

          shared_libs: [
              "android.hardware.graphics.composer3-V3-ndk",
          ],
       },
    }
  },
}

display_config_idl_cc_defaults {
  name: "disp_config_idl_composer_defaults",
  soong_config_variables: {
    target_aidl_or_hidl: {
       target_aidl: {
          defaults: [
                "shared_composer_vndk_lib",
                "vendor_shared_composer_vndk_lib",
          ],

          header_libs: [
               "display_headers",
               "qti_kernel_headers",
               "qti_display_kernel_headers",
               "device_kernel_headers",
          ],

          cflags: [
               "-Wno-missing-field-initializers",
               "-Wno-unused-parameter",
               "-DLOG_TAG=\"SDM\"",
               "-D__AIDL_COMPOSER__",
          ],

          shared_libs: [
               "libbinder",
               "libhardware",
               "libutils",
               "libcutils",
               "libsync",
               "libc++",
               "liblog",
               "libhidlbase",
               "liblog",
               "libfmq",
               "libhardware_legacy",
               "libsdmcore",
               "libqservice",
               "libdisplaydebug",
               "libsdmutils",
               "libui",
               "libgpu_tonemapper",
               "libEGL",
               "libGLESv2",
               "libGLESv3",
               "libqdMetaData",
               "android.hardware.graphics.mapper@2.0",
               "android.hardware.graphics.mapper@2.1",
               "android.hardware.graphics.mapper@3.0",
               "android.hardware.graphics.mapper@4.0",
               "android.hardware.graphics.allocator@2.0",
               "android.hardware.graphics.allocator@3.0",
               "android.hardware.graphics.allocator-V2-ndk",
               "vendor.qti.hardware.display.mapper@4.0",
               "libgralloctypes",
               "libdisplayconfig.qti",
               "libdrm",
               "libbinder_ndk",
               "android.hardware.common-V2-ndk",
               "vendor.qti.hardware.display.config-V7-ndk",
               "vendor.qti.hardware.display.demura-V1-ndk",
               "vendor.qti.hardware.display.mapperextensions@1.1",
               "vendor.qti.hardware.display.mapperextensions@1.2",
               "vendor.qti.hardware.display.mapperextensions@1.3",
               "libgrallocutils",
               "libgralloc.qti",
          ],

          static_libs: [
               "libaidlcommonsupport",
          ],

          srcs: [
               "AidlComposerClient.cpp",
               "AidlComposer.cpp",
               "AidlComposerHandleImporter.cpp",
               "cpuhint.cpp",
               "DisplayConfigAIDL.cpp",
               "display_null.cpp",
               "hwc_buffer_allocator.cpp",
               "hwc_buffer_sync_handler.cpp",
               "hwc_callbacks.cpp",
               "hwc_color_manager.cpp",
               "hwc_common.cpp",
               "hwc_debugger.cpp",
               "hwc_display_builtin.cpp",
               "hwc_display.cpp",
               "hwc_display_dummy.cpp",
               "hwc_display_pluggable.cpp",
               "hwc_display_pluggable_test.cpp",
               "hwc_display_virtual.cpp",
               "hwc_layers.cpp",
               "hwc_session.cpp",
               "hwc_session_services.cpp",
               "hwc_socket_handler.cpp",
               "hwc_tonemapper.cpp",
          ],

          init_rc: ["vendor.qti.hardware.display.composer-service.rc"],
          vintf_fragments: ["vendor.qti.hardware.display.composer-service.xml"],
       },
    }
  }
}

cc_binary {
    name: "vendor.qti.hardware.display.composer-service",
    defaults: [
        "disp_config_idl_composer_defaults",
    ],
    sanitize:{
        integer_overflow: true,
    },
    vendor: true,
    relative_install_path: "hw",
    cflags: [
        "-Wno-missing-field-initializers",
        "-Wno-unused-parameter",
    ],
    srcs: [
        "service.cpp",
    ],
}
