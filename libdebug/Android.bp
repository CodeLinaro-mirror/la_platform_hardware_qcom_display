cc_library_shared {

    name: "libdisplaydebug",
    defaults: ["display_defaults", "dlog_defaults", "qtidisplay_sdv_defaults"],
    sanitize: {
        integer_overflow: true,
    },
    vendor: true,

    shared_libs: [
        "libdl",
        "libdlog",
    ],
    header_libs: [
        "dlog_headers",
    ],
    cflags: [
        "-DLOG_TAG=\"SDM\"",
        "-Wall",
        "-Werror",
        "-fno-operator-names",
    ],
    export_include_dirs: ["."],
    srcs: ["debug_handler.cpp"],
}
