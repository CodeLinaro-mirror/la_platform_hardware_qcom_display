composer_srcs = ["*.cpp"]

cc_defaults {
    name: "composer-service_defaults",
    header_libs: [
        "display_headers",
        "qti_kernel_headers",
        "qti_display_kernel_headers",
        "device_kernel_headers",
        "libimapper_stablec",
        "libimapper_providerutils",
        "snapalloc_interface_headers",
        "common_interface_headers",
        "sdmclient_interface_headers",
    ],

    shared_libs: [
        "libbinder",
        "libhardware",
        "libhistogram",
        "libutils",
        "libcutils",
        "libsync",
        "libc++",
        "liblog",
        "libhidlbase",
        "liblog",
        "libfmq",
        "libhardware_legacy",
        "libsdmcore",
        "libqservice",
        "libdisplaydebug",
        "libsdmutils",
        "libui",
        "libgpu_tonemapper",
        "libEGL",
        "libGLESv2",
        "libGLESv3",
        "android.hardware.graphics.composer3-V3-ndk",
        "android.hardware.graphics.allocator-V2-ndk",
        "libgralloc.qti",
        "libgralloctypes",
        "libdisplayconfig.qti",
        "libdrm",
        "libbinder_ndk",
        "android.hardware.common-V2-ndk",
        "vendor.qti.hardware.display.config-V12-ndk",
        "vendor.qti.hardware.display.composer3-V1-ndk",
        "vendor.qti.hardware.display.demura-V1-ndk",
        "vendor.qti.hardware.display.aiqe-V2-ndk",
        "libgrallocutils",
        "libtinyxml2",
        "libmapperutils",
        "libvndksupport",
        "libsdmclient",
    ],

    static_libs: [
        "libaidlcommonsupport",
        "libbinder_random_parcel",
    ],
}

cc_binary {
    name: "vendor.qti.hardware.display.composer-service",
    defaults: [
        "qtidisplay_defaults",
        "composer-service_defaults"
    ],

    sanitize: {
        integer_overflow: true,
    },

    vendor: true,
    relative_install_path: "hw",

    cflags: [
        "-Wno-missing-field-initializers",
        "-Wno-unused-parameter",
        "-Wdeprecated-declarations",
        "-DLOG_TAG=\"SDM\"",
    ],

    srcs: composer_srcs,

    init_rc: ["vendor.qti.hardware.display.composer-service.rc"],
    vintf_fragments: ["vendor.qti.hardware.display.composer-service.xml"],
}


cc_fuzz {
    name: "displayconfig.aidl_fuzzer",
    defaults: [
        "composer-service_defaults",
        "service_fuzzer_defaults",
    ],

    vendor: true,

    static_libs: [
        "libbinder_random_parcel",
    ],

    header_libs: [
        "libcutils_headers",
    ],

    target: {
        android: {
            shared_libs: [
                "libbinder_ndk",
                "libbinder",
                "libutils",
                "libjsoncpp",
            ],
        },

        host: {
            shared_libs: [
                "libbinder_ndk",
                "libbinder",
                "libutils",
            ],
        },

        darwin: {
            enabled: false,
        },
    },

    srcs: [
        "AidlComposerClient.cpp",
        "AidlComposer.cpp",
        "AidlComposerHandleImporter.cpp",
        "DisplayConfigAIDL.cpp",
        "fuzzer.cpp",
        "gl_color_convert.cpp",
        "gl_color_convert_impl.cpp",
        "gl_common.cpp",
        "gl_layer_stitch.cpp",
        "gl_layer_stitch_impl.cpp",
        "hwc_buffer_allocator.cpp",
        "hwc_buffer_sync_handler.cpp",
        "hwc_common.cpp",
        "hwc_socket_handler.cpp",
        "QServiceBackend.cpp",
        "QtiComposer3Client.cpp",
    ],

    corpus: ["corpus/*"],
    fuzz_config: {
        cc: [
            "sasikuma@qti.qualcomm.com",
        ],
    },
}
