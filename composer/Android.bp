soong_config_module_type {
    name: "qticomposer_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "qtidisplay",
    variables: [
        "low_or_normal_ram",
    ],
    properties: [
        "vintf_fragments",
    ],
}

soong_config_string_variable {
    name: "low_or_normal_ram",
    values: ["low", "normal"],
}

qticomposer_cc_defaults {
    name: "qticomposer_defaults",
    soong_config_variables: {
        low_or_normal_ram: {
          low: {
            vintf_fragments: ["vendor.qti.hardware.display.composer-service-low-ram.xml"],
          },
          normal: {
            vintf_fragments: ["vendor.qti.hardware.display.composer-service.xml"],
          },
        },
    },
}

composer_srcs = ["*.cpp"]

cc_binary {

    name: "vendor.qti.hardware.display.composer-service",
    defaults: ["qtidisplay_defaults", "qticomposer_defaults"],
    sanitize: {
        integer_overflow: true,
    },
    vendor: true,
    relative_install_path: "hw",
    header_libs: [
        "display_headers",
        "qti_kernel_headers",
        "qti_display_kernel_headers",
    ],

    cflags: [
        "-Wno-missing-field-initializers",
        "-Wno-unused-parameter",
        "-DLOG_TAG=\"SDM\"",
    ],

    shared_libs: [
        "libbinder",
        "libhardware",
        "libhistogram",
        "libutils",
        "libcutils",
        "libsync",
        "libc++",
        "liblog",
        "libhidlbase",
        "liblog",
        "libfmq",
        "libhardware_legacy",
        "libsdmcore",
        "libqservice",
        "libqdutils",
        "libdisplaydebug",
        "libsdmutils",
        "libui",
        "libgpu_tonemapper",
        "libEGL",
        "libGLESv2",
        "libGLESv3",
        "android.hardware.graphics.mapper@4.0",
        "vendor.qti.hardware.display.mapper@4.0",
        "android.hardware.graphics.composer3-V2-ndk",
        "android.hardware.graphics.allocator-V2-ndk",
        "libgralloc.qti",
        "libqdMetaData",
        "libgralloctypes",
        "libdisplayconfig.qti",
        "libdrm",
        "libbinder_ndk",
        "android.hardware.common-V2-ndk",
        "vendor.qti.hardware.display.config-V7-ndk",
        "vendor.qti.hardware.display.composer3-V1-ndk",
        "libgrallocutils",
    ],

    static_libs: [
        "libaidlcommonsupport",
    ],
    srcs: composer_srcs,

    init_rc: ["vendor.qti.hardware.display.composer-service.rc"],
}
