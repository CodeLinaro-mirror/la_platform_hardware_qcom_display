composer_srcs = ["*.cpp"]

cc_binary {

    name: "vendor.qti.hardware.display.composer-service",
    defaults: [
        "qtidisplay_defaults",
        "composer3_defaults",
    ],
    sanitize: {
        integer_overflow: true,
    },
    vendor: true,
    relative_install_path: "hw",
    header_libs: [
        "display_headers",
        "qti_kernel_headers",
        "qti_display_kernel_headers",
        "libimapper_stablec",
        "libimapper_providerutils",
        "snapalloc_interface_headers",
        "common_interface_headers",
    ],

    cflags: [
        "-Wno-missing-field-initializers",
        "-Wno-unused-parameter",
        "-DLOG_TAG=\"SDM\"",
    ],

    shared_libs: [
        "libbinder",
        "libhardware",
        "libhistogram",
        "libutils",
        "libcutils",
        "libsync",
        "libc++",
        "liblog",
        "libhidlbase",
        "liblog",
        "libfmq",
        "libhardware_legacy",
        "libsdmcore",
        "libqservice",
        "libqdutils",
        "libdisplaydebug",
        "libsdmutils",
        "libui",
        "libgpu_tonemapper",
        "libEGL",
        "libGLESv2",
        "libGLESv3",
        "android.hardware.graphics.composer3-V3-ndk",
        "android.hardware.graphics.allocator-V2-ndk",
        "libgralloc.qti",
        "libqdMetaData",
        "libgralloctypes",
        "libdisplayconfig.qti",
        "libdrm",
        "libbinder_ndk",
        "android.hardware.common-V2-ndk",
        "vendor.qti.hardware.display.config-V7-ndk",
        "vendor.qti.hardware.display.composer3-V1-ndk",
        "libgrallocutils",
        "libvndksupport",
        "libmapperutils",
    ],

    static_libs: [
        "libaidlcommonsupport",
    ],
    srcs: composer_srcs,

    init_rc: ["vendor.qti.hardware.display.composer-service.rc"],
}


soong_config_module_type {
    name: "qticomposer3_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "qtidisplay",
    variables: [
        "composer_version",
    ],
    properties: [
         "vintf_fragments",
    ],
}

soong_config_string_variable {
    name: "composer_version",
    values: ["v3_3", "v3_4"],
}

qticomposer3_cc_defaults {
    name: "composer3_defaults",
    soong_config_variables: {
        composer_version: {
            v3_4: {
                vintf_fragments: ["vendor.qti.hardware.display.composer-service3_v4.xml"],
            },
            v3_3: {
                vintf_fragments: ["vendor.qti.hardware.display.composer-service3_v3.xml"],
            },
            conditions_default: {
                vintf_fragments: ["vendor.qti.hardware.display.composer-service3_v3.xml"],
            },
        },
    },
}
